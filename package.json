{
  "name": "@rudrat04/competitor-watch",
  "version": "0.1.0",
  "description": "Self-hosted agent that watches competitor web pages, explains what changed, and keeps battlecards current.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "competitor-watch": "dist/cli.js"
  },
  "files": [
    "dist/",
    "prompts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudrat04/competitor-watch.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.9",
    "linkedom": "^0.18.15",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
